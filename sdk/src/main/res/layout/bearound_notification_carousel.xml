<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded content of a CAROUSEL rich push: one card at a time with prev/next arrows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/bearound_push_title"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true" />

    <TextView
        android:id="@+id/bearound_push_body"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/bearound_push_carousel_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/bearound_push_carousel_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#99000000"
            android:ellipsize="end"
            android:paddingStart="48dp"
            android:paddingTop="4dp"
            android:paddingEnd="48dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bearound_push_carousel_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="#99000000"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/bearound_push_carousel_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="4dp"
            android:background="@null"
            android:contentDescription="@string/bearound_rich_push_previous"
            android:src="@drawable/bearound_ic_push_prev" />

        <ImageButton
            android:id="@+id/bearound_push_carousel_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:background="@null"
            android:contentDescription="@string/bearound_rich_push_next"
            android:src="@drawable/bearound_ic_push_next" />
    </FrameLayout>
</LinearLayout>
