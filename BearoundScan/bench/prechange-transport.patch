+def benchFlag = providers.gradleProperty("adaptiveBench").getOrElse("false")
+def benchRequested = benchFlag == "true"
+def benchEndpoint = benchRequested ? providers.gradleProperty("benchEndpoint").getOrElse("") : ""
+def benchToken = benchRequested ? providers.gradleProperty("benchToken").getOrElse("") : ""
+def benchUser = benchRequested ? providers.gradleProperty("benchUser").getOrElse("") : ""
+def benchAdaptive = benchRequested ? providers.gradleProperty("benchAdaptive").getOrElse("") : "true"
+def sha256 = { byte[] bytes -> MessageDigest.getInstance("SHA-256").digest(bytes).encodeHex().toString() }
+def localFixtureHost = { String host ->
+    if (host == "localhost" || host == "[::1]" || host == "::1") return true
+    def parts = host?.split("\\.")
+    if (parts?.length != 4 || !parts.every { it ==~ /[0-9]{1,3}/ && it.toInteger() <= 255 && it == it.toInteger().toString() }) return false
+    def octets = parts.collect { it.toInteger() }
+    return octets[0] == 127 || octets[0] == 10 ||
+        (octets[0] == 172 && octets[1] >= 16 && octets[1] <= 31) ||
+        (octets[0] == 192 && octets[1] == 168)
+}
+def validateBench = tasks.register("validateAdaptiveBench") {
+    doLast {
+        if (!(benchFlag in ["true", "false"])) throw new GradleException("adaptiveBench must be true or false")
+        if (!benchRequested) return
+        if (benchAdaptive != "false") throw new GradleException("The prechange baseline requires benchAdaptive=false")
+        def uri
+        try { uri = new URI(benchEndpoint) } catch (Exception ignored) { throw new GradleException("A local trusted HTTPS fixture endpoint is required") }
+        if (uri.scheme != "https" || !localFixtureHost(uri.host) || uri.userInfo != null ||
+            uri.rawQuery != null || uri.rawFragment != null || !(uri.path in ["", "/"]) || uri.port < 1 || uri.port > 65535)
+            throw new GradleException("A local trusted HTTPS fixture endpoint with an explicit port is required")
+        if (!(benchToken ==~ /fixture-token-[A-Za-z0-9][A-Za-z0-9_-]{0,127}/))
+            throw new GradleException("An explicit synthetic fixture-token credential is required")
+        if (!(benchUser ==~ /fixture-[A-Za-z0-9][A-Za-z0-9_-]{0,127}/))
+            throw new GradleException("An explicit synthetic fixture user is required")
+        if (!(benchAdaptive in ["true", "false"])) throw new GradleException("benchAdaptive must be true or false")
+    }
+}
