+
+def benchAssetDirectory = layout.buildDirectory.dir("generated/adaptiveBench/assets")
+android.sourceSets.debug.assets.srcDir(benchAssetDirectory)
+def benchSources = rootProject.fileTree(rootProject.projectDir) {
+    include "sdk/src/**", "sdk/build.gradle", "sdk/proguard*", "BearoundScan/src/**", "BearoundScan/build.gradle"
+    include "BearoundScan/bench/**", "build.gradle", "settings.gradle", "gradle.properties", "gradle/wrapper/**"
+    exclude "**/build/**", "**/.gradle/**", "**/local.properties"
+}
+def revision = providers.provider {
+    def output = new ByteArrayOutputStream()
+    exec { workingDir rootProject.projectDir; commandLine "git", "rev-parse", "HEAD"; standardOutput = output }
+    output.toString("UTF-8").trim()
+}
+def fingerprintTask = tasks.register("generateAdaptiveBenchAsset") {
+    dependsOn(validateBench)
+    inputs.files(benchSources)
+    inputs.property("revision", revision)
+    inputs.property("enabled", benchRequested)
+    inputs.property("endpoint", benchEndpoint)
+    inputs.property("tokenFingerprint", sha256(benchToken.getBytes("UTF-8")))
+    inputs.property("userFingerprint", sha256(benchUser.getBytes("UTF-8")))
+    inputs.property("adaptive", benchAdaptive)
+    outputs.dir(benchAssetDirectory)
+    doLast {
+        def directory = benchAssetDirectory.get().asFile
+        delete(directory)
+        if (!benchRequested) return
+        directory.mkdirs()
+        def hashes = new TreeMap()
+        benchSources.files.findAll { it.isFile() }.each { source ->
+            hashes[rootProject.projectDir.toPath().relativize(source.toPath()).toString()] = sha256(source.bytes)
+        }
+        def flags = new TreeMap([configuration: "Debug", benchEnabled: true,
+            endpoint: benchEndpoint.replaceAll('/$', ''), tokenFingerprint: sha256(benchToken.getBytes("UTF-8")),
+            userFingerprint: sha256(benchUser.getBytes("UTF-8")), adaptiveSamplingAvailable: false,
+            applicationId: "io.bearound.bearoundscan.adaptivebaseline", telemetryCompanionEnabled: false, userCaTrust: true])
+        def identity = new TreeMap([sourceCommit: revision.get(), files: hashes, flags: flags])
+        def fingerprint = sha256(JsonOutput.toJson(identity).getBytes("UTF-8"))
+        def manifest = new TreeMap(identity)
+        manifest.putAll([schemaVersion: 1, platform: "android", arm: "baseline", control: "pre_change", transportOnlyInstrumentation: true,
+            sourceFingerprint: fingerprint, gradleVersion: gradle.gradleVersion, javaVersion: System.getProperty("java.version")])
+        new File(directory, "adaptive_sampling_bench_build.json").text = JsonOutput.prettyPrint(JsonOutput.toJson(manifest)) + "\n"
+    }
+}
+tasks.configureEach { task ->
+    if (task.name == "preDebugBuild") task.dependsOn(validateBench)
+    if (task.name == "mergeDebugAssets") task.dependsOn(fingerprintTask)
+}
